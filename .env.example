# Dán key vào đây. Hoặc mở app → Cài đặt API (lưu trên máy).
# Không có key thì app KHÔNG trả dữ liệu giả — trừ nút «Xem mẫu».

# AISStream — vị trí tàu AIS live (miễn phí, WebSocket)
# Repo: https://github.com/aisstream/aisstream
# Tạo key: https://aisstream.io (đăng nhập GitHub)
# Chỉ lọc theo MMSI 9 số — không tra container / bill of lading.
AISSTREAM_API_KEY=

# SeaRates — khuyến nghị cho container + B/L + lịch tàu POL→POD (trả phí/trial)
# https://www.searates.com/reference/tracking
SEARATES_API_KEY=

# ShipsGo — container / B/L
# https://shipsgo.com
SHIPSGO_AUTH_CODE=

# JSONCargo — đổi tên / IMO tàu thành MMSI (rồi AISStream lấy vị trí live)
# https://jsoncargo.com
JSONCARGO_API_KEY=
